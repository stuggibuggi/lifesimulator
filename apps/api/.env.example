# MariaDB (Plesk) connection – copy to .env on the server
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=https://vorsorgenavigator.stoffner.de
APP_PUBLIC_URL=https://vorsorgenavigator.stoffner.de

DB_HOST=localhost
DB_PORT=3306
DB_USER=goal_user
DB_PASSWORD=your_password
DB_NAME=goal_db

# --- Mail (pick ONE approach) ---
# A) Recommended on Plesk same host: local sendmail/postfix
SMTP_TRANSPORT=sendmail
SENDMAIL_PATH=/usr/sbin/sendmail
MAIL_FROM=GOAL <info@vorsorgenavigator.stoffner.de>

# B) SMTP to local MTA (fallback if sendmail path missing)
# SMTP_TRANSPORT=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_IGNORE_TLS=true
# SMTP_USER=info@vorsorgenavigator.stoffner.de
# SMTP_PASS=your_mailbox_password
# MAIL_FROM=GOAL <info@vorsorgenavigator.stoffner.de>

# --- Schul-SSO (OIDC, optional) ---
# Leave OIDC_ISSUER unset to disable SSO and keep password login only.
# OIDC_ISSUER=https://idp.example.school/realms/school
# OIDC_CLIENT_ID=goal-life-simulator
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URI=https://vorsorgenavigator.stoffner.de/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_ALLOWED_EMAIL_DOMAINS=school.example
# OIDC_TEACHER_ROLE_CLAIM=roles
# OIDC_TEACHER_ROLE_VALUES=teacher,staff
