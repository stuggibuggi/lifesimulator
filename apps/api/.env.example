# MariaDB (Plesk) connection – copy to .env on the server
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=https://vorsorgenavigator.stoffner.de
APP_PUBLIC_URL=https://vorsorgenavigator.stoffner.de

# Option A: single URL
# DATABASE_URL=mysql://user:password@localhost:3306/goal_db

# Option B: discrete fields (typical for Plesk MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=goal_user
DB_PASSWORD=your_password
DB_NAME=goal_db

# SMTP (Plesk mailbox) – required for verification / password-reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@vorsorgenavigator.stoffner.de
SMTP_PASS=your_mailbox_password
MAIL_FROM=GOAL <noreply@vorsorgenavigator.stoffner.de>
