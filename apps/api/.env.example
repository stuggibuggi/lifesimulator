# MariaDB (Plesk) connection – copy to .env on the server
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=https://vorsorgenavigator.stoffner.de

# Option A: single URL
# DATABASE_URL=mysql://user:password@localhost:3306/goal_db

# Option B: discrete fields (typical for Plesk MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=goal_user
DB_PASSWORD=your_password
DB_NAME=goal_db
